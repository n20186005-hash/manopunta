---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, buildAlternates, htmlLangAttr, languagesList } from '../i18n/ui';
import { ogLocale } from '../config';
import { attraction, SITE_URL } from '../config/attraction';

interface Props {
  title: string;
  description: string;
  path?: string | Record<string, string>;
  image?: string;
  noIndex?: boolean;
  /**
   * 限制输出的 hreflang / og:locale:alternate 语言范围。
   * 用于仅发布单一语言版本的专题页（如西语深度攻略），
   * 避免输出指向不存在翻译页的 hreflang 回链。
   */
  langs?: string[];
}

const { title, description, path = '', image = attraction.heroImage, noIndex = false, langs } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const htmlLang = htmlLangAttr(lang);
const alts = buildAlternates(path);
const canonical = alts[lang] ?? alts.es;

const langsToUse = langs && langs.length ? langs : [...languagesList];
const alternateLocales = Object.entries(ogLocale)
  .filter(([code]) => code !== lang && langsToUse.includes(code))
  .map(([, value]) => value);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="author" content={attraction.fullName} />
    <link rel="canonical" href={canonical} />

    <!-- Google Search Console 域名验证：将下方 content 替换为你账号的验证码并取消注释 -->
    <!-- <meta name="google-site-verification" content="YOUR_VERIFICATION_TOKEN" /> -->

    {langsToUse.map((l) => (
      <link rel="alternate" hreflang={l} href={alts[l]} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alts.xDefault} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={attraction.fullName} />
    <meta property="og:locale" content={ogLocale[lang] ?? lang} />
    {alternateLocales.map((value) => <meta property="og:locale:alternate" content={value} />)}
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={`${attraction.fullName} in ${attraction.city}`} />
    <meta property="og:image:width" content={String(attraction.heroImageWidth)} />
    <meta property="og:image:height" content={String(attraction.heroImageHeight)} />
    <meta property="og:image:type" content="image/jpeg" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={`${attraction.fullName} in ${attraction.city}`} />

    <!-- 明确的地理实体信号（Geo meta） -->
    <meta name="geo.region" content={`${attraction.countryCode}-${attraction.region}`} />
    <meta name="geo.placename" content={`${attraction.city}, ${attraction.region}, ${attraction.country}`} />
    <meta name="geo.position" content={`${attraction.latitude};${attraction.longitude}`} />
    <meta name="ICBM" content={`${attraction.latitude}, ${attraction.longitude}`} />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0f2015" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c1a14" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon-180.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={attraction.shortName} />
    <meta name="application-name" content={attraction.shortName} />

    <meta name="google-adsense-account" content="ca-pub-XXXXXXXXXX" />
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXX" crossorigin="anonymous"></script>

    <!-- Google Analytics 4 (G-HXM22WWPKP) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'granted',
      });
      gtag('config', 'G-HXM22WWPKP');
    </script>

    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}
      })();
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>
