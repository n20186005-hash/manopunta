---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const b = messages.infoBar;
const items = [
  { icon: '📍', label: b.address, value: b.addressValue },
  { icon: '📞', label: b.phone, value: b.phoneValue, href: 'tel:+59893324497' },
  { icon: '🗺️', label: b.plusCode, value: b.plusCodeValue },
  { icon: '🕒', label: b.hours, value: b.hoursValue },
];
---

<div class="max-w-5xl mx-auto px-4 -mt-10 relative z-20">
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 rounded-2xl p-5 border shadow-lg" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
    {items.map((it) => (
      <div class="flex items-start gap-3 px-2">
        <span class="text-xl leading-none mt-0.5" aria-hidden="true">{it.icon}</span>
        <div class="min-w-0">
          <div class="text-xs uppercase tracking-wide mb-0.5" style="color: var(--text-muted);">{it.label}</div>
          {it.href ? (
            <a href={it.href} class="text-sm font-semibold block truncate hover:underline" style="color: var(--text-primary);">{it.value}</a>
          ) : (
            <div class="text-sm font-semibold truncate" style="color: var(--text-primary);" title={it.value}>{it.value}</div>
          )}
        </div>
      </div>
    ))}
  </div>
</div>
