---
import { getI18n } from '../i18n/ui';
import { attraction } from '../config/attraction';
const { messages, lang } = getI18n(Astro.url);
const intro = messages.intro;
const om = messages.officialManagement;
const seo = messages.seo;

// 地理面包屑与归属层级：{{ATTRACTION_FULL_NAME}} → {{CITY_NAME}} → {{STATE_PROVINCE}} → {{COUNTRY_NAME}}
const trail = [
  { name: attraction.fullName, url: `/${lang}`, external: false },
  { name: attraction.city, url: 'https://es.wikipedia.org/wiki/Punta_del_Este', external: true },
  { name: attraction.region, url: 'https://es.wikipedia.org/wiki/Departamento_de_Maldonado', external: true },
  { name: attraction.country, url: 'https://es.wikipedia.org/wiki/Uruguay', external: true },
];
---

<section id="visit" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-6xl mx-auto px-4">
    <!-- 语义面包屑：实体 → 城市 → 省 → 国家 -->
    <nav aria-label={seo.breadcrumbLabel} class="mb-6 text-sm" style="color: var(--text-muted);">
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
        {trail.map((item, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && <span aria-hidden="true">›</span>}
            <a
              href={item.url}
              class="hover:opacity-70"
              style={i === trail.length - 1 ? 'color: var(--text-primary);' : 'color: var(--accent);'}
              {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {item.name}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-5" style="color: var(--text-primary);">{seo.aboutHeading}</h2>

    <!-- 首段等位声明：域名含义与官方全称语义等同 -->
    <p class="text-lg leading-relaxed mb-4" style="color: var(--text-secondary);" set:html={seo.introLead}></p>

    <div class="grid lg:grid-cols-2 gap-12 items-start">
      <div>
        <h3 class="font-display text-xl font-semibold mb-4" style="color: var(--text-primary);">{intro.title}</h3>
        <p class="text-lg leading-relaxed mb-8" style="color: var(--text-secondary);">{intro.description}</p>

        <div class="rounded-2xl p-6 border" style="background: var(--bg-tertiary); border-color: var(--border-color);">
          <h3 class="font-semibold mb-3" style="color: var(--text-primary);">{om.title}</h3>
          <p class="text-base leading-relaxed mb-4" style="color: var(--text-secondary);">{om.text}</p>
          {om.ecoNote && (
            <p class="text-sm font-medium rounded-xl px-4 py-3" style="background: var(--accent); color: #fff;">{om.ecoNote}</p>
          )}
        </div>
      </div>

      <div class="space-y-6">
        <div class="rounded-2xl p-6 border" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
          <h3 class="font-semibold mb-4" style="color: var(--text-primary);">{intro.visitGuide.title}</h3>
          <ul class="space-y-3 text-base" style="color: var(--text-secondary);">
            {intro.visitGuide.items.map((item) => (
              <li class="flex gap-3"><span style="color: var(--accent);">✓</span><span>{item}</span></li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl p-6 border" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
          <h3 class="font-semibold mb-4" style="color: var(--text-primary);">{intro.alsoKnownAs.title}</h3>
          <ul class="space-y-3 text-base" style="color: var(--text-secondary);">
            {intro.alsoKnownAs.items.map((item) => (
              <li class="flex gap-3"><span style="color: var(--accent);">✦</span><span>{item}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- 周边语义集群 -->
    <p class="text-base leading-relaxed mt-12" style="color: var(--text-secondary);" set:html={seo.nearbyLead}></p>
  </div>
</section>
