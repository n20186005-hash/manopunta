---
/**
 * 实时天气 + 未来 7 日预报 + 智能出行建议
 *
 * 数据获取策略（服务器端获取 + 缓存）：
 *  1. 构建/请求时在服务端拉取一次，直接写进 HTML —— 无 JS 也能看到内容，利于首屏与 SEO；
 *  2. 浏览器端再用 sessionStorage 做 10 分钟缓存并静默刷新，保证游客看到的是实时天气。
 *
 * 建议引擎（见 src/scripts/weather.ts）服务端与客户端共用：
 *  根据天气组合动态输出「出行穿搭 / 游玩安排 / 随身物品」，风险提醒置顶且无预警自动隐藏。
 * 页面不展示任何「免费 / 无需密钥」字样。
 */
import { getI18n } from '../i18n/ui';
import { attraction } from '../config/attraction';
import {
  buildAdvice,
  categoryOf,
  beaufort,
  parseWeather,
  parseMarine,
  parseTide,
  tideAdvice,
  tideChartHtml,
  WEATHER_CATEGORY,
  type WeatherNow,
  type WeatherDay,
  type MarineInfo,
  type TideInfo,
} from '../scripts/weather';

const { messages } = getI18n(Astro.url);
const w = messages.weather;

const TZ = 'America/Montevideo';

/* ---------------- 服务端拉取 ---------------- */
const forecastUrl = new URL('https://api.open-meteo.com/v1/forecast');
forecastUrl.searchParams.set('latitude', String(attraction.latitude));
forecastUrl.searchParams.set('longitude', String(attraction.longitude));
forecastUrl.searchParams.set(
  'current',
  'temperature_2m,relative_humidity_2m,apparent_temperature,is_day,precipitation,weather_code,wind_speed_10m,wind_gusts_10m',
);
forecastUrl.searchParams.set(
  'daily',
  'weather_code,temperature_2m_max,temperature_2m_min,precipitation_sum,precipitation_probability_max,uv_index_max,wind_speed_10m_max,wind_gusts_10m_max,sunrise,sunset',
);
forecastUrl.searchParams.set('timezone', TZ);
forecastUrl.searchParams.set('forecast_days', '7');
forecastUrl.searchParams.set('wind_speed_unit', 'kmh');

const marineUrl = new URL('https://marine-api.open-meteo.com/v1/marine');
marineUrl.searchParams.set('latitude', String(attraction.latitude));
marineUrl.searchParams.set('longitude', String(attraction.longitude));
marineUrl.searchParams.set('current', 'wave_height,sea_surface_temperature');
// 潮汐：sea_level_height_msl = 相对平均海平面的天文潮位（逐小时）
marineUrl.searchParams.set('hourly', 'sea_level_height_msl');
marineUrl.searchParams.set('timezone', TZ);
marineUrl.searchParams.set('forecast_days', '3');

const [forecastRes, marineRes] = await Promise.allSettled([
  fetch(forecastUrl, { headers: { 'User-Agent': `manopunta.com (+${attraction.id})` } }).then((r) =>
    r.ok ? r.json() : null,
  ),
  fetch(marineUrl, { headers: { 'User-Agent': `manopunta.com (+${attraction.id})` } }).then((r) =>
    r.ok ? r.json() : null,
  ),
]);

const forecast = forecastRes.status === 'fulfilled' ? forecastRes.value : null;
const marineData = marineRes.status === 'fulfilled' ? marineRes.value : null;

const parsed = parseWeather(forecast);
const marine: MarineInfo = parseMarine(marineData);

const fallbackNow: WeatherNow = {
  code: 0, isDay: 1, temp: 0, feels: 0, humidity: 0, windKmh: 0, gustKmh: 0, precip: 0,
};
const fallbackDay: WeatherDay = {
  code: 0, max: 0, min: 0, precipProb: 0, precipSum: 0, uv: 0, windMax: 0, gustMax: 0,
  sunrise: '', sunset: '',
};

const now: WeatherNow = parsed?.now ?? fallbackNow;
const day: WeatherDay = parsed?.day ?? fallbackDay;
const daily = forecast?.daily ?? null;
const times: string[] = daily?.time ?? [];

const advice = buildAdvice(now, day, marine, w as any);

/* ---------------- 潮汐 ---------------- */
// 服务端「现在」按景点时区取本地时间，与接口返回的本地时间口径保持一致
const serverNow = new Date().toLocaleString('sv-SE', { timeZone: TZ }).replace(' ', 'T').slice(0, 16);
const tide: TideInfo = parseTide(marineData, serverNow);
const tideTips = tideAdvice(tide, w as any);
const tideChart = tideChartHtml(tide, { now: w.tideNowMark, unit: 'm', mean: '0 m' });
const tideScaleLabel =
  tide.scale === 'spring'
    ? w.tideScaleSpring
    : tide.scale === 'neap'
      ? w.tideScaleNeap
      : tide.scale === 'medium'
        ? w.tideScaleMedium
        : '';
const tideTrendLabel =
  tide.trend === 'rising' ? w.tideRising : tide.trend === 'falling' ? w.tideFalling : w.tideSteady;
const meters = (v: number | null) => (v == null ? '–' : v.toFixed(2));
const tideMoment = (e: TideInfo['next']) => (e ? `${String(e.time).slice(11, 16)} · ${e.height.toFixed(2)} m` : '–');

/* ---------------- 展示辅助 ---------------- */
const ICON: Record<string, string> = {
  clear: '☀️', mainlyClear: '🌤️', partlyCloudy: '⛅', overcast: '☁️', fog: '🌫️',
  drizzle: '🌦️', freezingDrizzle: '🌧️', rain: '🌧️', freezingRain: '🌧️',
  snow: '🌨️', showers: '🌦️', snowShowers: '🌨️', thunderstorm: '⛈️',
};
const iconFor = (code: number, isDay: number = 1) => {
  const k = categoryOf(code);
  if (!isDay && (k === 'clear' || k === 'mainlyClear')) return '🌙';
  return ICON[k] ?? '⛅';
};
const labelFor = (code: number) => (w.codes as any)[categoryOf(code)] ?? '';
const hhmm = (iso: string) => (iso ? String(iso).slice(11, 16) : '–:–');
const dayLabel = (iso: string, i: number) =>
  i === 0 ? w.today : (w.dayNames[new Date(`${iso}T12:00:00`).getDay()] ?? '');

const windForce = beaufort(Math.max(now.windKmh, day.windMax));

/* 传给浏览器的文案与坐标（客户端静默刷新时复用同一套规则） */
const clientConfig = {
  lat: attraction.latitude,
  lon: attraction.longitude,
  tz: TZ,
  codes: w.codes,
  days: w.dayNames,
  today: w.today,
  forceUnit: w.forceUnit,
  copy: {
    alThunder: w.alThunder, alRain: w.alRain, alWind: w.alWind, alUv: w.alUv,
    alHeat: w.alHeat, alFog: w.alFog, alSea: w.alSea,
    oHeat: w.oHeat, oCold: w.oCold, oMild: w.oMild, oSwing: w.oSwing, oRain: w.oRain, oUv: w.oUv, oWind: w.oWind,
    pThunder: w.pThunder, pHeavyRain: w.pHeavyRain, pLightRain: w.pLightRain, pFog: w.pFog,
    pRainProb: w.pRainProb, pClear: w.pClear, pCloudy: w.pCloudy, pHeat: w.pHeat, pWind5: w.pWind5, pWind7: w.pWind7,
    pSeaRough: w.pSeaRough, pSeaCalm: w.pSeaCalm,
    iUmbrella: w.iUmbrella, iRaincoat: w.iRaincoat, iSun: w.iSun, iWater: w.iWater,
    iJacket: w.iJacket, iWarm: w.iWarm, iWind: w.iWind, iSea: w.iSea, iMask: w.iMask,
    tRising: w.tRising, tFalling: w.tFalling, tNearHigh: w.tNearHigh, tNearLow: w.tNearLow, tSpring: w.tSpring,
  },
  tide: {
    now: w.tideNowMark, rising: w.tideRising, falling: w.tideFalling, steady: w.tideSteady,
    high: w.tideHigh, low: w.tideLow,
    spring: w.tideScaleSpring, medium: w.tideScaleMedium, neap: w.tideScaleNeap,
  },
};
---

<section id="weather" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">{w.title}</h2>
    <p class="text-center text-lg mb-8" style="color: var(--text-secondary);">{w.subtitle}</p>

    <div class="rounded-2xl border p-6 sm:p-8" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
      <!-- 基础天气卡片 -->
      <div class="flex flex-wrap items-center gap-x-10 gap-y-6">
        <div class="flex items-center gap-5">
          <span class="text-6xl leading-none" id="w-icon" aria-hidden="true">{iconFor(now.code, now.isDay)}</span>
          <div>
            <div class="font-display text-5xl font-bold leading-none" style="color: var(--text-primary);">
              <span id="w-temp">{Math.round(now.temp)}</span><span class="text-2xl align-top">°C</span>
            </div>
            <div class="mt-2 text-base font-medium" id="w-desc" style="color: var(--text-secondary);">{labelFor(now.code)}</div>
            <div class="text-xs mt-1" style="color: var(--text-muted);">
              {w.feelsLike} <span id="w-feels">{Math.round(now.feels)}</span>°C
              <span class="mx-1">·</span>
              <span id="w-range">{Math.round(day.min)}° / {Math.round(day.max)}°</span>
            </div>
          </div>
        </div>

        <dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-8 gap-y-4 sm:ml-auto text-sm">
          <div>
            <dt style="color: var(--text-muted);">💧 {w.humidity}</dt>
            <dd class="font-semibold mt-0.5" style="color: var(--text-primary);"><span id="w-hum">{now.humidity}</span>%</dd>
          </div>
          <div>
            <dt style="color: var(--text-muted);">🌬️ {w.wind}</dt>
            <dd class="font-semibold mt-0.5" style="color: var(--text-primary);"><span id="w-wind">{Math.round(now.windKmh)}</span> km/h</dd>
          </div>
          <div>
            <dt style="color: var(--text-muted);">🌧️ {w.precipitation}</dt>
            <dd class="font-semibold mt-0.5" style="color: var(--text-primary);"><span id="w-precip">{day.precipProb}</span>%</dd>
          </div>
          <div>
            <dt style="color: var(--text-muted);">☀️ {w.uvIndex}</dt>
            <dd class="font-semibold mt-0.5" style="color: var(--text-primary);"><span id="w-uv">{day.uv ? Math.round(day.uv) : '–'}</span></dd>
          </div>
        </dl>
      </div>

      <!-- 智能建议区 -->
      <div class="mt-8 rounded-2xl border p-5 sm:p-6" style="background: var(--bg-tertiary); border-color: var(--border-color);">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-lg" aria-hidden="true">🧭</span>
          <h3 class="font-display text-lg font-semibold" style="color: var(--text-primary);">{w.adviceTitle}</h3>
        </div>

        <!-- 风险提醒（仅有预警时显示，置顶） -->
        <div id="w-alert-box" class="mb-5 rounded-xl px-4 py-3" style="border-left: 4px solid #dc2626; background: color-mix(in srgb, #dc2626 12%, transparent);" hidden={advice.alerts.length === 0}>
          <div class="flex items-start gap-2">
            <span class="text-lg leading-none" aria-hidden="true">⚠️</span>
            <div>
              <div class="text-sm font-semibold mb-1" style="color: #dc2626;">{w.alertLabel}</div>
              <ul id="w-alerts" class="text-sm space-y-1 leading-relaxed" style="color: var(--text-primary);">
                {advice.alerts.map((t) => <li>{t}</li>)}
              </ul>
            </div>
          </div>
        </div>

        <div class="grid gap-5 md:grid-cols-3">
          <div>
            <div class="flex items-center gap-2 mb-2 text-sm font-semibold" style="color: var(--text-primary);">
              <span aria-hidden="true">🧥</span>{w.outfitLabel}
            </div>
            <ul id="w-outfit" class="text-sm space-y-1.5 leading-relaxed list-disc pl-4" style="color: var(--text-secondary);">
              {advice.outfit.map((t) => <li>{t}</li>)}
            </ul>
          </div>
          <div>
            <div class="flex items-center gap-2 mb-2 text-sm font-semibold" style="color: var(--text-primary);">
              <span aria-hidden="true">🗺️</span>{w.planLabel}
            </div>
            <ul id="w-plan" class="text-sm space-y-1.5 leading-relaxed list-disc pl-4" style="color: var(--text-secondary);">
              {advice.plan.map((t) => <li>{t}</li>)}
            </ul>
          </div>
          <div>
            <div class="flex items-center gap-2 mb-2 text-sm font-semibold" style="color: var(--text-primary);">
              <span aria-hidden="true">🎒</span>{w.itemsLabel}
            </div>
            <ul id="w-items" class="text-sm space-y-1.5 leading-relaxed list-disc pl-4" style="color: var(--text-secondary);">
              {advice.items.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        </div>
      </div>

      <!-- 海边情况（本景点为海滩场景） -->
      <div class="mt-4 grid grid-cols-2 sm:grid-cols-5 gap-x-6 gap-y-4 text-sm rounded-2xl border p-5" style="background: var(--card-bg); border-color: var(--border-color);">
        <div>
          <dt style="color: var(--text-muted);">🌬️ {w.windForceLabel}</dt>
          <dd class="font-semibold mt-0.5" style="color: var(--text-primary);"><span id="w-force">{windForce}</span> {w.forceUnit}</dd>
        </div>
        <div>
          <dt style="color: var(--text-muted);">🌊 {w.waveLabel}</dt>
          <dd class="font-semibold mt-0.5" style="color: var(--text-primary);"><span id="w-wave">{marine.waveHeight != null ? marine.waveHeight.toFixed(1) : '–'}</span> m</dd>
        </div>
        <div>
          <dt style="color: var(--text-muted);">🌡️ {w.seaTempLabel}</dt>
          <dd class="font-semibold mt-0.5" style="color: var(--text-primary);"><span id="w-seatemp">{marine.seaTemp != null ? Math.round(marine.seaTemp) : '–'}</span>°C</dd>
        </div>
        <div>
          <dt style="color: var(--text-muted);">🌅 {w.sunriseLabel}</dt>
          <dd class="font-semibold mt-0.5" style="color: var(--text-primary);"><span id="w-sunrise">{hhmm(day.sunrise)}</span></dd>
        </div>
        <div>
          <dt style="color: var(--text-muted);">🌇 {w.sunsetLabel}</dt>
          <dd class="font-semibold mt-0.5" style="color: var(--text-primary);"><span id="w-sunset">{hhmm(day.sunset)}</span></dd>
        </div>
      </div>

      <!-- 潮汐（海边场景的核心信息：赶海 / 礁石安全） -->
      <div class="mt-4 rounded-2xl border p-5 sm:p-6" style="background: var(--bg-tertiary); border-color: var(--border-color);">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
          <div class="flex items-center gap-2">
            <span class="text-lg" aria-hidden="true">🌊</span>
            <h3 class="font-display text-lg font-semibold" style="color: var(--text-primary);">{w.tideTitle}</h3>
          </div>
          <span id="w-tide-scale" class="text-xs font-semibold px-2.5 py-1 rounded-full" style="background: color-mix(in srgb, var(--accent) 15%, transparent); color: var(--accent);" hidden={!tideScaleLabel}>{tideScaleLabel}</span>
        </div>

        <dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-4 text-sm">
          <div>
            <dt style="color: var(--text-muted);">📍 {w.tideNow}</dt>
            <dd class="mt-0.5">
              <span class="font-semibold" style="color: var(--text-primary);"><span id="w-tide-now">{meters(tide.current)}</span> m</span>
              <span id="w-tide-trend" class="ml-2 text-[11px] px-1.5 py-0.5 rounded" style="background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent);">{tideTrendLabel}</span>
            </dd>
          </div>
          <div>
            <dt style="color: var(--text-muted);">⬆️ {w.tideNextHigh}</dt>
            <dd class="font-semibold mt-0.5" style="color: var(--text-primary);"><span id="w-tide-next-high">{tideMoment(tide.nextHigh)}</span></dd>
          </div>
          <div>
            <dt style="color: var(--text-muted);">⬇️ {w.tideNextLow}</dt>
            <dd class="font-semibold mt-0.5" style="color: var(--text-primary);"><span id="w-tide-next-low">{tideMoment(tide.nextLow)}</span></dd>
          </div>
          <div>
            <dt style="color: var(--text-muted);">📊 {w.tideRangeLabel}</dt>
            <dd class="font-semibold mt-0.5" style="color: var(--text-primary);"><span id="w-tide-range">{meters(tide.range)}</span> m</dd>
          </div>
        </dl>

        <div class="mt-5 rounded-xl border p-4 pb-6" style="background: var(--card-bg); border-color: var(--border-color);">
          <div class="text-xs mb-3" style="color: var(--text-muted);">{w.tideChartTitle}</div>
          <div id="w-tide-chart" set:html={tideChart}></div>
        </div>

        <div class="mt-4">
          <div class="text-xs font-semibold mb-2" style="color: var(--text-muted);">{w.tideTodayTitle}</div>
          <div id="w-tide-today" class="flex flex-wrap gap-2">
            {tide.today.map((e) => (
              <span class="text-xs px-2.5 py-1 rounded-full border" style="border-color: var(--border-color); color: var(--text-secondary);">
                {e.kind === 'high' ? '⬆️ ' + w.tideHigh : '⬇️ ' + w.tideLow} {hhmm(e.time)} · {e.height.toFixed(2)} m
              </span>
            ))}
          </div>
        </div>

        <ul id="w-tide-tips" class="mt-4 text-sm space-y-1.5 leading-relaxed list-disc pl-4" style="color: var(--text-secondary);">
          {tideTips.map((t) => <li>{t}</li>)}
        </ul>

        <div class="mt-3 text-[11px]" style="color: var(--text-muted);">{w.tideNote}</div>
      </div>

      <!-- 7 日预报 -->
      <h3 class="font-display text-lg font-semibold mt-8 mb-4" style="color: var(--text-primary);">{w.forecastTitle}</h3>
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-7 gap-3" id="w-days">
        {times.map((iso, i) => (
          <div class="rounded-xl border p-3 text-center" style="background: var(--bg-tertiary); border-color: var(--border-color);">
            <div class="text-xs font-medium mb-2" style="color: var(--text-muted);">{dayLabel(iso, i)}</div>
            <div class="text-2xl mb-2" aria-hidden="true">{iconFor(daily.weather_code[i])}</div>
            <div class="text-sm font-semibold" style="color: var(--text-primary);">{Math.round(daily.temperature_2m_max[i])}°</div>
            <div class="text-xs" style="color: var(--text-muted);">{Math.round(daily.temperature_2m_min[i])}°</div>
            <div class="text-[11px] mt-1" style="color: var(--accent);">{daily.precipitation_probability_max?.[i] ?? 0}%</div>
          </div>
        ))}
      </div>

      <div class="mt-5 flex flex-wrap items-center justify-between gap-2 text-[11px]" style="color: var(--text-muted);">
        <span>{w.updated} <span id="w-updated">{hhmm(forecast?.current?.time ?? '')}</span></span>
        <span>{w.source}: <a href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer" class="underline hover:opacity-70">Open-Meteo</a></span>
      </div>
    </div>
  </div>
</section>

<script type="application/json" id="w-cfg" is:inline set:html={JSON.stringify(clientConfig)}></script>

<script>
  import {
    buildAdvice,
    categoryOf,
    beaufort,
    parseWeather,
    parseMarine,
    parseTide,
    tideAdvice,
    tideChartHtml,
  } from '../scripts/weather';

  const cfgEl = document.getElementById('w-cfg');
  const daysEl = document.getElementById('w-days');
  if (cfgEl && daysEl) {
    const cfg = JSON.parse(cfgEl.textContent || '{}');
    const ICONS: Record<string, string> = {
      clear: '☀️', mainlyClear: '🌤️', partlyCloudy: '⛅', overcast: '☁️', fog: '🌫️',
      drizzle: '🌦️', freezingDrizzle: '🌧️', rain: '🌧️', freezingRain: '🌧️',
      snow: '🌨️', showers: '🌦️', snowShowers: '🌨️', thunderstorm: '⛈️',
    };

    const iconOf = (code: number, isDay = 1) => {
      const k = categoryOf(code);
      if (!isDay && (k === 'clear' || k === 'mainlyClear')) return '🌙';
      return ICONS[k] || '⛅';
    };
    const labelOf = (code: number) => (cfg.codes && cfg.codes[categoryOf(code)]) || '';
    const esc = (s: string) =>
      String(s).replace(/[&<>"']/g, (m) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m] as string),
      );
    const listHtml = (arr: string[]) => arr.map((t) => '<li>' + esc(t) + '</li>').join('');
    const setText = (id: string, v: unknown) => {
      const el = document.getElementById(id);
      if (el) el.textContent = String(v);
    };
    const setList = (id: string, arr: string[]) => {
      const el = document.getElementById(id);
      if (el) el.innerHTML = listHtml(arr);
    };
    const hhmm = (iso?: string) => (iso ? String(iso).slice(11, 16) : '–:–');
    /** 按景点时区取本地「现在」，与接口返回的本地时间口径一致 */
    const nowIso = () => {
      try {
        return new Date().toLocaleString('sv-SE', { timeZone: cfg.tz }).replace(' ', 'T').slice(0, 16);
      } catch (e) {
        return '';
      }
    };

    function render(forecast: any, marineRaw: any) {
      const parsed = parseWeather(forecast);
      if (!parsed) return;
      const { now, day } = parsed;
      const marine = parseMarine(marineRaw);
      const daily = forecast.daily || {};

      setText('w-icon', iconOf(now.code, now.isDay));
      setText('w-temp', Math.round(now.temp));
      setText('w-desc', labelOf(now.code));
      setText('w-feels', Math.round(now.feels));
      setText('w-range', Math.round(day.min) + '° / ' + Math.round(day.max) + '°');
      setText('w-hum', now.humidity);
      setText('w-wind', Math.round(now.windKmh));
      setText('w-precip', day.precipProb);
      setText('w-uv', day.uv ? Math.round(day.uv) : '–');

      // 智能建议（与服务器端同一套规则）
      const adv = buildAdvice(now, day, marine, cfg.copy || {});
      const box = document.getElementById('w-alert-box');
      if (box) box.hidden = adv.alerts.length === 0;
      setList('w-alerts', adv.alerts);
      setList('w-outfit', adv.outfit);
      setList('w-plan', adv.plan);
      setList('w-items', adv.items);

      // 海边情况
      setText('w-force', beaufort(Math.max(now.windKmh, day.windMax)));
      setText('w-wave', marine.waveHeight == null ? '–' : marine.waveHeight.toFixed(1));
      setText('w-seatemp', marine.seaTemp == null ? '–' : Math.round(marine.seaTemp));
      setText('w-sunrise', hhmm(day.sunrise));
      setText('w-sunset', hhmm(day.sunset));

      // 潮汐
      const L = cfg.tide || {};
      const tide = parseTide(marineRaw, nowIso());
      setText('w-tide-now', tide.current == null ? '–' : tide.current.toFixed(2));
      setText('w-tide-trend', tide.trend === 'rising' ? L.rising : tide.trend === 'falling' ? L.falling : L.steady);
      setText(
        'w-tide-next-high',
        tide.nextHigh ? hhmm(tide.nextHigh.time) + ' · ' + tide.nextHigh.height.toFixed(2) + ' m' : '–',
      );
      setText(
        'w-tide-next-low',
        tide.nextLow ? hhmm(tide.nextLow.time) + ' · ' + tide.nextLow.height.toFixed(2) + ' m' : '–',
      );
      setText('w-tide-range', tide.range == null ? '–' : tide.range.toFixed(2));

      const scaleEl = document.getElementById('w-tide-scale');
      if (scaleEl) {
        const lbl =
          tide.scale === 'spring' ? L.spring : tide.scale === 'neap' ? L.neap : tide.scale === 'medium' ? L.medium : '';
        scaleEl.textContent = lbl || '';
        scaleEl.hidden = !lbl;
      }

      const chartEl = document.getElementById('w-tide-chart');
      if (chartEl && tide.series.length > 2) {
        chartEl.innerHTML = tideChartHtml(tide, { now: L.now, unit: 'm', mean: '0 m' });
      }

      const todayEl = document.getElementById('w-tide-today');
      if (todayEl) {
        todayEl.innerHTML = tide.today
          .map(
            (e) =>
              '<span class="text-xs px-2.5 py-1 rounded-full border" style="border-color: var(--border-color); color: var(--text-secondary);">' +
              (e.kind === 'high' ? '⬆️ ' + esc(L.high || '') : '⬇️ ' + esc(L.low || '')) +
              ' ' +
              esc(hhmm(e.time)) +
              ' · ' +
              e.height.toFixed(2) +
              ' m</span>',
          )
          .join('');
      }
      setList('w-tide-tips', tideAdvice(tide, cfg.copy || {}));

      if (forecast.current && forecast.current.time) setText('w-updated', hhmm(forecast.current.time));

      if (daily.time) {
        daysEl.innerHTML = daily.time
          .map((iso: string, i: number) => {
            const dn = i === 0 ? cfg.today : cfg.days[new Date(iso + 'T12:00:00').getDay()] || '';
            const pp = (daily.precipitation_probability_max || [])[i] || 0;
            return (
              '<div class="rounded-xl border p-3 text-center" style="background: var(--bg-tertiary); border-color: var(--border-color);">' +
              '<div class="text-xs font-medium mb-2" style="color: var(--text-muted);">' + esc(dn) + '</div>' +
              '<div class="text-2xl mb-2" aria-hidden="true">' + iconOf(daily.weather_code[i]) + '</div>' +
              '<div class="text-sm font-semibold" style="color: var(--text-primary);">' + Math.round(daily.temperature_2m_max[i]) + '°</div>' +
              '<div class="text-xs" style="color: var(--text-muted);">' + Math.round(daily.temperature_2m_min[i]) + '°</div>' +
              '<div class="text-[11px] mt-1" style="color: var(--accent);">' + pp + '%</div>' +
              '</div>'
            );
          })
          .join('');
      }
    }

    const KEY = 'mano-weather-v2';
    const TTL = 10 * 60 * 1000;

    let cached: any = null;
    try {
      cached = JSON.parse(sessionStorage.getItem(KEY) || 'null');
    } catch (e) {
      cached = null;
    }

    const base =
      'latitude=' + cfg.lat + '&longitude=' + cfg.lon + '&timezone=' + encodeURIComponent(cfg.tz);
    const forecastUrl =
      'https://api.open-meteo.com/v1/forecast?' + base +
      '&current=temperature_2m,relative_humidity_2m,apparent_temperature,is_day,precipitation,weather_code,wind_speed_10m,wind_gusts_10m' +
      '&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_sum,precipitation_probability_max,uv_index_max,wind_speed_10m_max,wind_gusts_10m_max,sunrise,sunset' +
      '&forecast_days=7&wind_speed_unit=kmh';
    const marineUrl =
      'https://marine-api.open-meteo.com/v1/marine?' + base +
      '&current=wave_height,sea_surface_temperature' +
      '&hourly=sea_level_height_msl&forecast_days=3';

    const getJson = (url: string) =>
      fetch(url).then((r) => (r.ok ? r.json() : null)).catch(() => null);

    if (cached && Date.now() - cached.t < TTL) {
      render(cached.f, cached.m);
    } else {
      Promise.all([getJson(forecastUrl), getJson(marineUrl)]).then(([f, m]) => {
        if (!f) return;
        render(f, m);
        try {
          sessionStorage.setItem(KEY, JSON.stringify({ t: Date.now(), f: f, m: m }));
        } catch (e) {}
      });
    }
  }
</script>
