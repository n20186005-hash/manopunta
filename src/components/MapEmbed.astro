---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const m = messages.mapSection;
const embedUrl = 'https://www.google.com/maps?q=-34.9615,-54.9492(Los+Dedos+de+Punta+del+Este)&z=16&output=embed';
---

<section id="map" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">{m.title}</h2>
    <p class="text-center text-lg mb-8" style="color: var(--text-secondary);">{m.subtitle}</p>

    <div class="map-container overflow-hidden border" style="border-color: var(--map-border);">
      <iframe
        src={embedUrl}
        width="100%"
        height="420"
        style="border:0;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title={m.title}
      ></iframe>
    </div>

    <div class="text-center mt-8">
      <a href={m.mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-block px-8 py-3 rounded-full font-semibold text-white" style="background: var(--accent);">
        📍 {m.openMaps}
      </a>
    </div>
  </div>
</section>
