---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import InfoBar from './InfoBar.astro';
import Weather from './Weather.astro';
import Intro from './Intro.astro';
import InfoSection from './InfoSection.astro';
import Gallery from './Gallery.astro';
import PracticalInfo from './PracticalInfo.astro';
import Reviews from './Reviews.astro';
import Transportation from './Transportation.astro';
import MapEmbed from './MapEmbed.astro';
import Recommendations from './Recommendations.astro';
import FAQ from './FAQ.astro';
import SourcesSection from './SourcesSection.astro';
import { getI18n } from '../i18n/ui';
import { attraction, galleryImages, SITE_URL } from '../config/attraction';

// 由当前 URL 推断语言：/es、/en、/zh、/gn 取路径首段；
// 根路径 / 没有语言段，getI18n 会回退到 defaultLang('es')。
const { messages, lang } = getI18n(Astro.url);
const pageUrl = `${SITE_URL}/${lang}`;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: messages.faq.categories
    .flatMap((c: any) => c.items)
    .map((it: any) => ({
      '@type': 'Question',
      name: it.q,
      acceptedAnswer: { '@type': 'Answer', text: it.a },
    })),
};

const attractionSchema = {
  '@context': 'https://schema.org',
  // 同时声明景点与雕塑两类，覆盖「观光地标」与「雕塑作品」两种查询意图
  '@type': ['TouristAttraction', 'Sculpture'],
  '@id': attraction.id,
  name: attraction.fullName,
  alternateName: attraction.alternateNames,
  description: messages.meta.description,
  url: pageUrl,
  image: galleryImages,
  isAccessibleForFree: true,
  publicAccess: true,
  telephone: attraction.telephone,
  hasMap: attraction.mapsShareUrl,
  sameAs: [attraction.mapsShareUrl, attraction.govtTourismUrl],
  isPartOf: { '@id': `${SITE_URL}/#website` },
  creator: {
    '@type': 'Person',
    name: attraction.creator,
    nationality: { '@type': 'Country', name: attraction.creatorNationality },
  },
  dateCreated: attraction.dateCreated,
  material: attraction.material,
  address: {
    '@type': 'PostalAddress',
    streetAddress: attraction.streetAddress,
    addressLocality: attraction.city,
    addressRegion: attraction.region,
    postalCode: attraction.postalCode,
    addressCountry: attraction.countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: attraction.latitude,
    longitude: attraction.longitude,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '23:59',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.5',
    reviewCount: '28416',
    bestRating: '5',
  },
  availableLanguage: ['es', 'en', 'zh', 'gn'],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: attraction.fullName, item: pageUrl },
    { '@type': 'ListItem', position: 2, name: attraction.city, item: 'https://es.wikipedia.org/wiki/Punta_del_Este' },
    { '@type': 'ListItem', position: 3, name: attraction.region, item: 'https://es.wikipedia.org/wiki/Departamento_de_Maldonado' },
    { '@type': 'ListItem', position: 4, name: attraction.country, item: 'https://es.wikipedia.org/wiki/Uruguay' },
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: attraction.fullName,
  alternateName: attraction.alternateNames,
  url: SITE_URL,
  inLanguage: lang,
  about: { '@id': attraction.id },
};

const imageObjectSchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  '@id': `${pageUrl}#primaryimage`,
  contentUrl: attraction.heroImage,
  url: attraction.heroImage,
  caption: messages.seo.heroAlt,
  creditText: 'Original photographers',
  representativeOfPage: true,
};
---

<BaseLayout title={messages.meta.title} description={messages.meta.description} path="" image={attraction.heroImage}>
  <Hero />
  <InfoBar />
  <Weather />
  <Intro />
  <InfoSection />
  <Gallery />
  <PracticalInfo />
  <Reviews />
  <Transportation />
  <MapEmbed />
  <Recommendations />
  <FAQ />
  <SourcesSection />

  <script type="application/ld+json" set:html={JSON.stringify(attractionSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(imageObjectSchema)} is:inline />
</BaseLayout>
