---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const r = messages.reviews;
---

<section id="reviews" class="section-padding" style="background: var(--bg-primary);">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3" style="color: var(--text-primary);">{r.title}</h2>
    <p class="text-base mb-8" style="color: var(--text-secondary);">{r.declaration}</p>

    <div class="inline-flex items-center gap-5 rounded-2xl px-8 py-6 border" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
      <div class="text-5xl font-display font-bold leading-none" style="color: var(--accent);">{r.ratingValue}</div>
      <div class="text-left">
        <div class="text-yellow-400 text-xl leading-none" aria-hidden="true">★★★★★</div>
        <div class="text-sm mt-1.5" style="color: var(--text-secondary);">{r.reviewCount}</div>
      </div>
    </div>

    <p class="text-xs mt-3" style="color: var(--text-muted);">{r.source} · {r.updated}</p>

    <div class="mt-8">
      <a href={r.mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-block px-8 py-3 rounded-full font-semibold text-white" style="background: var(--accent);">
        📍 {r.moreReviews}
      </a>
    </div>
  </div>
</section>
