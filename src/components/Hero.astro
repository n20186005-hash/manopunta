---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const h = messages.hero;
---

<section class="relative min-h-[88vh] flex items-center justify-center text-center overflow-hidden">
  <div class="absolute inset-0" style={`background-image: linear-gradient(rgba(15,32,21,0.55), rgba(15,32,21,0.55)), url('https://manopunta.com/gallery/punta-del-este-9.jpg'); background-size: cover; background-position: center;`}></div>
  <div class="relative z-10 px-6 max-w-3xl animate-fade-in-up">
    <span class="inline-block px-3 py-1 mb-5 rounded-full text-sm font-medium" style="background: rgba(255,255,255,0.15); color: #fff; backdrop-filter: blur(4px);">
      ⭐ {h.rating} · {h.reviewCount}
    </span>
    <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-bold text-white leading-tight mb-5">
      {h.title}
    </h1>
    <p class="text-lg sm:text-xl text-white/90 mb-4 max-w-2xl mx-auto">
      {h.subtitle}
    </p>
    <p class="text-sm text-white/80 mb-8 inline-flex items-center gap-2">
      🕒 {h.hours}
    </p>
    <div>
      <a href={h.mapsUrl} target="_blank" rel="noopener noreferrer"
         class="inline-block px-8 py-3.5 rounded-full font-semibold text-white shadow-lg hover:opacity-90 transition"
         style="background: var(--accent);">
        📍 {h.openMaps}
      </a>
    </div>
  </div>
</section>
